        "jsCode": "// Массив с объектами\nconst fruits = [\n  { name: 'apple', price: 50 },\n  { name: 'banana', price: 20 },\n  { name: 'cherry', price: 300 },\n  { name: 'kiwi', price: 80 }\n];\n\n// let для накопителей\nlet expensiveFruits = [];\nlet totalPrice = 0;\n\n// Цикл for\nfor (let i = 0; i < fruits.length; i++) {\n  const fruit = fruits[i];\n\n  // if / else\n  if (fruit.price > 70) {\n    expensiveFruits.push(fruit.name);\n  } else {\n    // ничего\n  }\n\n  totalPrice = totalPrice + fruit.price;\n}\n\n// Возврат объекта с полем payload\nreturn [\n  {\n    json: {\n      payload: {\n        student: 'vauchkevich',\n        expensiveFruits: expensiveFruits,\n        totalPrice: totalPrice,\n        totalItems: fruits.length\n      }\n    }\n  }\n];"
