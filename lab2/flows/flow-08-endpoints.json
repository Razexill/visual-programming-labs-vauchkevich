    {
        "id": "973c622ca24ef315",
        "type": "function",
        "z": "b3ebd3ff9c45ef14",
        "name": "function 5",
        "func": "// 1. Получаем параметры из запроса\nlet id = msg.req.params.id; // Из path: /api/items/123\nlet limit = msg.req.query.limit || 10; // Из query: ?limit=5\n\n// 2. Проверка на ошибку 400 (Bad Request)\n// Если id не передан или не является числом\nif (!id || isNaN(id)) {\n    msg.statusCode = 400;\n    msg.payload = { error: \"Bad Request: ID должен быть числом\" };\n    return msg;\n}\n\n// 3. Имитация базы данных\nconst database = {\n    \"1\": { name: \"Яблоко\", price: 100 },\n    \"2\": { name: \"Банан\", price: 50 },\n    \"3\": { name: \"Вишня\", price: 200 }\n};\n\n// 4. Проверка на ошибку 404 (Not Found)\n// Если такого id нет в нашей \"базе\"\nif (!database[id]) {\n    msg.statusCode = 404;\n    msg.payload = { error: \"Not Found: Товар с id \" + id + \" не найден\" };\n    return msg;\n}\n\n// 5. Успешный ответ (200 OK)\nmsg.statusCode = 200;\nmsg.payload = {\n    id: id,\n    item: database[id],\n    limit: limit\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 360,
