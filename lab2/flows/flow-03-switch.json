    {
        "id": "3eb2b091f2ac6cb4",
        "type": "function",
        "z": "cfc8b52fb3f24a44",
        "name": "function 2",
        "func": "// 1. Получаем число из inject\nlet input = msg.payload; \n\n// 2. Создаем массив чисел (например, множители)\nconst multipliers = [2, 3, 4]; \nlet results = []; // Пустой массив для результатов\n\n// 3. Проверяем, что пришло именно число (if/else)\nif (typeof input === 'number') {\n    \n    // 4. Используем цикл for, чтобы пройтись по массиву\n    for (let i = 0; i < multipliers.length; i++) {\n        // Умножаем входное число на каждый элемент массива\n        let multiplied = input * multipliers[i];\n        results.push(multiplied);\n    }\n\n    // 5. Формируем объект, который вернем дальше\n    msg.payload = {\n        original: input,          // То, что мы отправили\n        multiplyBy2: input * 2,  // Твое условие: умножаем на 2\n        allResults: results,     // Результаты умножения на массив\n        status: \"Успех\"\n    };\n    \n} else {\n    // Если отправили не число, возвращаем ошибку\n    msg.payload = {\n        error: \"Ошибка! Вы отправили не число.\",\n        status: \"Ошибка\"\n    };\n}\n\nreturn msg;",
